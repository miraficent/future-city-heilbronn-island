{
  "schemaVersion": 1,
  "institution": "aim",
  "name": "Roboter-Express mit Schleifen-Lauf",
  "version": "1.1.0",
  "aktivitaeten": [
    {
      "titel": "Die erste Lieferung",
      "modul": "roboter-code",
      "variante": 0
    },
    {
      "titel": "Ein Zwischenstopp",
      "modul": "roboter-code",
      "variante": 1
    },
    {
      "titel": "Der Schleifen-Lauf",
      "modul": "plugin",
      "html": "<style>\n  * { box-sizing: border-box; }\n  body { margin: 0; font: 17px/1.4 system-ui, sans-serif; color: #1c1934; background: #fffbee; }\n  .spiel { --feld: 48px; max-width: 640px; margin: 0 auto; padding: 12px 16px; display: grid; gap: 12px; }\n  .spiel.gitter { --feld: 40px; }\n  h2 { margin: 0; font-size: 21px; }\n  p { margin: 0; }\n  .flaeche { display: flex; flex-wrap: wrap; align-items: center; justify-content: center; gap: 12px; }\n  .flaeche .programm { flex: 1 1 300px; }\n  .bahn { display: grid; gap: 4px; justify-content: center; }\n  .feld { width: var(--feld); height: var(--feld); border-radius: 10px; background: #f1e6c8; display: grid; place-items: center; }\n  .feld.ziel { background: #ffd27a; outline: 3px dashed #ed805c; outline-offset: -3px; }\n  .roboter { width: 70%; height: 70%; border-radius: 9px; background: #ed805c; position: relative; }\n  .roboter::before, .roboter::after { content: \"\"; position: absolute; top: 30%; width: 20%; height: 20%; border-radius: 50%; background: #fff; }\n  .roboter::before { left: 20%; }\n  .roboter::after { right: 20%; }\n  .programm { background: #fff; border: 3px solid #1c1934; border-radius: 14px; padding: 10px 12px; display: grid; gap: 8px; }\n  .schleife { display: flex; flex-wrap: wrap; align-items: center; gap: 8px; }\n  .koerper { background: #e8f0ff; border-radius: 10px; padding: 6px 12px; }\n  .zahl { font-size: 26px; font-weight: 700; min-width: 2ch; text-align: center; }\n  .knoepfe { display: flex; flex-wrap: wrap; gap: 10px; }\n  button { font: inherit; min-width: 48px; min-height: 48px; padding: 0 14px; border-radius: 12px; border: 3px solid #1c1934; background: #fff; color: inherit; cursor: pointer; }\n  button:disabled { opacity: 0.5; cursor: default; }\n  button:focus-visible { outline: 4px solid #4b7bec; outline-offset: 2px; }\n  .los { background: #1c1934; color: #fff; padding: 0 24px; }\n  #meldung { min-height: 2.8em; }\n</style>\n\n<div class=\"spiel\" id=\"spiel\">\n  <h2>Der Schleifen-Lauf</h2>\n  <p id=\"auftrag\"></p>\n  <div class=\"flaeche\">\n    <div class=\"bahn\" id=\"bahn\" aria-hidden=\"true\"></div>\n    <div class=\"programm\" id=\"programm\" aria-label=\"Programm des Roboters\"></div>\n  </div>\n  <div class=\"knoepfe\">\n    <button class=\"los\" id=\"los\">Los!</button>\n    <button id=\"zurueck\">Roboter zurückstellen</button>\n  </div>\n  <p id=\"meldung\" role=\"status\" aria-live=\"polite\"></p>\n</div>\n\n<script>\n(function () {\n  // Die Spielwelt setzt die Altersstufe: \"start\" (6-8), \"weiter\" (9-11) oder \"profi\" (12-17).\n  var AUFGABEN = {\n    start: {\n      breite: 6, hoehe: 1, ziel: [4, 0],\n      auftrag: \"Der Roboter soll zum gelben Feld. Wie oft muss er einen Schritt machen? Stelle die Zahl ein und drücke Los.\",\n      schleifen: [{ richtung: \"rechts\", schritte: 1, text: \"1 Schritt nach rechts\" }]\n    },\n    weiter: {\n      breite: 9, hoehe: 1, ziel: [6, 0],\n      auftrag: \"Jetzt macht der Roboter in jeder Runde 2 Schritte. Wie viele Runden braucht er bis zum gelben Feld?\",\n      schleifen: [{ richtung: \"rechts\", schritte: 2, text: \"2 Schritte nach rechts\" }]\n    },\n    profi: {\n      breite: 5, hoehe: 4, ziel: [3, 2],\n      auftrag: \"Zwei Schleifen nacheinander: erst nach rechts, dann nach oben. Stelle beide Zahlen so ein, dass der Roboter genau auf dem gelben Feld hält.\",\n      schleifen: [\n        { richtung: \"rechts\", schritte: 1, text: \"1 Schritt nach rechts\" },\n        { richtung: \"hoch\", schritte: 1, text: \"1 Schritt nach oben\" }\n      ]\n    }\n  };\n  var aufgabe = AUFGABEN[window.COSMOS_STUFE] || AUFGABEN.start;\n  var zahlen = aufgabe.schleifen.map(function () { return 0; });\n  var pos = [0, 0];\n  var laeuft = false;\n  var gemeldet = false;\n\n  var spiel = document.getElementById(\"spiel\");\n  var bahn = document.getElementById(\"bahn\");\n  var programm = document.getElementById(\"programm\");\n  var meldung = document.getElementById(\"meldung\");\n\n  if (aufgabe.hoehe > 1) spiel.classList.add(\"gitter\");\n  document.getElementById(\"auftrag\").textContent = aufgabe.auftrag;\n  bahn.style.gridTemplateColumns = \"repeat(\" + aufgabe.breite + \", var(--feld))\";\n\n  function zeichne() {\n    var html = \"\";\n    for (var y = aufgabe.hoehe - 1; y >= 0; y--) {\n      for (var x = 0; x < aufgabe.breite; x++) {\n        var ziel = x === aufgabe.ziel[0] && y === aufgabe.ziel[1];\n        var roboter = x === pos[0] && y === pos[1];\n        html += '<div class=\"feld' + (ziel ? \" ziel\" : \"\") + '\">' + (roboter ? '<div class=\"roboter\"></div>' : \"\") + \"</div>\";\n      }\n    }\n    bahn.innerHTML = html;\n  }\n\n  programm.innerHTML = aufgabe.schleifen.map(function (s, i) {\n    return '<div class=\"schleife\"><span>Wiederhole</span>' +\n      '<button data-i=\"' + i + '\" data-d=\"-1\" aria-label=\"Eine Runde weniger\">&minus;</button>' +\n      '<span class=\"zahl\" id=\"zahl' + i + '\">0</span>' +\n      '<button data-i=\"' + i + '\" data-d=\"1\" aria-label=\"Eine Runde mehr\">+</button>' +\n      '<span>mal:</span><span class=\"koerper\">' + s.text + \"</span></div>\";\n  }).join(\"\");\n\n  programm.addEventListener(\"click\", function (e) {\n    var knopf = e.target.closest(\"button\");\n    if (!knopf || laeuft) return;\n    var i = Number(knopf.dataset.i);\n    zahlen[i] = Math.max(0, Math.min(9, zahlen[i] + Number(knopf.dataset.d)));\n    document.getElementById(\"zahl\" + i).textContent = zahlen[i];\n  });\n\n  function sperre(an) {\n    spiel.querySelectorAll(\"button\").forEach(function (b) { b.disabled = an; });\n  }\n\n  function los() {\n    if (laeuft) return;\n    laeuft = true;\n    sperre(true);\n    pos = [0, 0];\n    zeichne();\n    meldung.textContent = \"Der Roboter fährt los ...\";\n    var befehle = [];\n    aufgabe.schleifen.forEach(function (s, i) {\n      for (var runde = 0; runde < zahlen[i]; runde++) {\n        for (var k = 0; k < s.schritte; k++) befehle.push(s.richtung);\n      }\n    });\n    function schritt() {\n      if (!befehle.length) return fertig(false);\n      var r = befehle.shift();\n      var nx = pos[0] + (r === \"rechts\" ? 1 : 0);\n      var ny = pos[1] + (r === \"hoch\" ? 1 : 0);\n      if (nx >= aufgabe.breite || ny >= aufgabe.hoehe) return fertig(true);\n      pos = [nx, ny];\n      zeichne();\n      setTimeout(schritt, 320);\n    }\n    setTimeout(schritt, 320);\n  }\n\n  function fertig(amRand) {\n    laeuft = false;\n    sperre(false);\n    var dx = aufgabe.ziel[0] - pos[0];\n    var dy = aufgabe.ziel[1] - pos[1];\n    if (!amRand && dx === 0 && dy === 0) {\n      meldung.textContent = \"Geschafft! Eine Schleife wiederholt Befehle. So musst du denselben Befehl nicht viele Male hinschreiben.\";\n      if (!gemeldet) {\n        gemeldet = true;\n        parent.postMessage({ type: \"cosmos:complete\" }, \"*\");\n      }\n      return;\n    }\n    if (amRand) {\n      meldung.textContent = \"Hoppla, der Roboter ist am Rand angekommen. Das waren zu viele Runden. Probier eine kleinere Zahl.\";\n    } else if (aufgabe.hoehe === 1) {\n      meldung.textContent = dx > 0\n        ? \"Fast! Noch \" + dx + (dx === 1 ? \" Feld\" : \" Felder\") + \" bis zum Ziel. Probier es noch einmal.\"\n        : \"Ein bisschen zu weit. Probier eine kleinere Zahl.\";\n    } else {\n      meldung.textContent = \"Schau, wo der Roboter steht. \" +\n        (dx > 0 ? \"Nach rechts fehlt noch etwas. \" : dx < 0 ? \"Nach rechts war es zu weit. \" : \"Nach rechts passt es. \") +\n        (dy > 0 ? \"Nach oben fehlt noch etwas.\" : dy < 0 ? \"Nach oben war es zu weit.\" : \"Nach oben passt es.\");\n    }\n  }\n\n  document.getElementById(\"los\").addEventListener(\"click\", los);\n  document.getElementById(\"zurueck\").addEventListener(\"click\", function () {\n    if (laeuft) return;\n    pos = [0, 0];\n    zeichne();\n    meldung.textContent = \"\";\n  });\n\n  zeichne();\n})();\n</script>\n"
    }
  ]
}
